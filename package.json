{
  "name": "mockzin",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor que permite mockar APIs via API de administração (Fastify + TypeScript)",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter @mockzin/server dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @mockzin/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
